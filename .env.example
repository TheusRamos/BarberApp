# Copie para .env e substitua os valores abaixo. Nao use credenciais reais neste modelo.
DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/barberapp
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=America/Sao_Paulo
PGSSL=false

# Apenas para frontend hospedado em outra origem; sem caminho ou barra final.
# CORS_ORIGIN=https://organizacao.github.io

# Atras de proxy reverso (Nginx, Render, Railway etc.), informe o numero de proxies.
# Nao defina sem proxy: o cliente poderia forjar o IP usado nos limites de login.
# TRUST_PROXY=1

# Cabecalho com o IP real do cliente gravado pelo proxy. No Render: CF-Connecting-IP.
# Nao defina sem esse proxy: o cliente escolheria o IP usado nos limites de login.
# CLIENT_IP_HEADER=CF-Connecting-IP

# Login com Google: ativo quando as tres variaveis estao definidas.
# No Google Cloud, autorize o redirecionamento PUBLIC_URL + /api/auth/google/callback.
# PUBLIC_URL=http://127.0.0.1:3000
# GOOGLE_CLIENT_ID=SUBSTITUA.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=SUBSTITUA

# Maximo de reservas ativas futuras + pedidos na fila por cliente (padrao 3).
# MAX_ACTIVE_BOOKINGS=3

# Preencha temporariamente para npm run admin:create.
# Remova ADMIN_PASSWORD do .env depois de criar a conta.
# ADMIN_NAME="Nome do administrador"
# ADMIN_EMAIL=admin@exemplo.com
# ADMIN_PHONE=11999999999
# ADMIN_PASSWORD="SUBSTITUA_POR_UMA_SENHA_FORTE"

# npm test nao carrega .env automaticamente. Defina esta variavel no terminal.
# Use exclusivamente um banco vazio e descartavel, separado do banco da aplicacao.
# TEST_DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/barberapp_test
