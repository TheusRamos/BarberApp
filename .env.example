# Copie para .env e substitua os valores abaixo. Nao use credenciais reais neste modelo.
DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/barberapp
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=America/Sao_Paulo
PGSSL=false

# Apenas para frontend hospedado em outra origem; sem caminho ou barra final.
# CORS_ORIGIN=https://organizacao.github.io

# Preencha temporariamente para npm run admin:create.
# Remova ADMIN_PASSWORD do .env depois de criar a conta.
# ADMIN_NAME="Nome do administrador"
# ADMIN_EMAIL=admin@exemplo.com
# ADMIN_PHONE=11999999999
# ADMIN_PASSWORD="SUBSTITUA_POR_UMA_SENHA_FORTE"

# npm test nao carrega .env automaticamente. Defina esta variavel no terminal.
# Use exclusivamente um banco vazio e descartavel, separado do banco da aplicacao.
# TEST_DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/barberapp_test
